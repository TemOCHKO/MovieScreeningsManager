<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:MovieScreeningsManager.UI.View"
             xmlns:models="clr-namespace:MovieScreeningsManager.UIModels;assembly=MovieScreeningsManager.UIModels"
             x:Class="MovieScreeningsManager.UI.View.CinemaHallsPage"
             x:DataType="pages:CinemaHallsPage"
             Title="Cinema Halls Page">
    <CollectionView
        ItemsSource="{Binding CinemaHalls}"
        SelectionMode="Single"
        SelectionChanged="CinemaHallSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate
                x:DataType="models:CinemaHallUIModel">
                <Border
                    Stroke="DimGrey"
                    Padding="2"
                    Margin="10, 10">
                    <VerticalStackLayout>
                        <Label
                            Style="{StaticResource SubHeadline}"
                            Text="{Binding Name}">
                            
                        </Label>
                        <Label Text="{Binding Capacity}"
                               FontSize="15"
                               HorizontalOptions="Center">
                            
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        
    </CollectionView>
</ContentPage>